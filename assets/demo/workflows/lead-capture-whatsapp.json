        [
          {
            "node": "Hot lead?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hot lead?": {
      "main": [
        [
          {
            "node": "WhatsApp owner",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WhatsApp owner": {
      "main": [
        [
          {
            "node": "Reply to website",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email follow-up": {
      "main": [
        [
          {
            "node": "Reply to website",
